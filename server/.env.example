# ==========================================================
# KANOFLOW BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# Copy file này thành server/.env và điền thông tin máy bạn
# ==========================================================

# Cổng chạy Backend Express + Socket.io
PORT=5000
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Kết nối Microsoft SQL Server
DB_HOST=localhost
DB_PORT=1433
DB_NAME=TaskManager
DB_USER=sa
DB_PASSWORD=YOUR_SQL_SERVER_PASSWORD

# Khóa bí mật ký JWT (nên đổi thành chuỗi ngẫu nhiên dài >= 32 ký tự)
JWT_SECRET=kanoflow_super_secret_jwt_key_change_me_in_production

# ==========================================================
# (TÙY CHỌN) CẤU HÌNH AI CLOUD (Google Gemini hoặc OpenAI)
# Nếu để trống, hệ thống vẫn chạy bộ phân tích AI nội bộ tiếng Việt
# ==========================================================
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash

# ==========================================================
# (TÙY CHỌN) CẤU HÌNH EMAIL THẬT (SMTP / Nodemailer)
# Dùng cho: OTP Quên mật khẩu & Email mời thành viên vào Board
# Với Gmail: Bật 2FA -> tạo "Mật khẩu ứng dụng" (App Password)
# Nếu để trống, hệ thống tự động fallback về chế độ local demo
# ==========================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KanoFlow Workspace" <no-reply@kanoflow.local>

# ==========================================================
# (TÙY CHỌN) ĐĂNG NHẬP THẬT BẰNG GOOGLE & FACEBOOK (OAUTH 2.0)
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
#   Authorized redirect URI: http://localhost:5000/api/auth/google/callback
# Meta for Developers -> Facebook Login -> Settings
#   Valid OAuth Redirect URI: http://localhost:5000/api/auth/facebook/callback
# ==========================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
